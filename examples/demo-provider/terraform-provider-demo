#!/usr/bin/env python3
"""
Entry point for terraform-provider-demo.

This script bootstraps the demo provider for use with Terraform.
It uses relative paths to locate the src directory and pyvider.
"""
import sys
from pathlib import Path

# Get the directory where this script is located
script_dir = Path(__file__).resolve().parent

# Add src directory to path for demo package
src_dir = script_dir / "src"
if src_dir.exists():
    sys.path.insert(0, str(src_dir))

# Import the demo package to trigger component registration
import demo  # noqa: F401

# Run pyvider CLI
from pyvider.cli import main

main()
