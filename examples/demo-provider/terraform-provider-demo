#!/usr/bin/env python3
import sys
import asyncio

# Add to path
sys.path.insert(0, '/Users/tim/code/gh/provide-io/pyvider/src')
sys.path.insert(0, '/Users/tim/code/gh/provide-io/pyvider/examples/demo-provider')

# Import provider to register components
import provider  # noqa

# Manually register components since there are no entry points
from pyvider.hub.components import registry
from pyvider.hub.discovery import ComponentDiscovery

async def register_components():
    discovery = ComponentDiscovery(registry)
    await discovery._process_module(provider)

asyncio.run(register_components())

# Run pyvider CLI
from pyvider.cli import main
main()
